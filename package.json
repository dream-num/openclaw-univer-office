{
  "name": "@dream-num/openclaw-univer-office",
  "version": "0.1.0",
  "private": true,
  "description": "Univer Office artifact creation, isolated review, and delivery tools for OpenClaw.",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run --config ./vitest.config.ts",
    "test:live": "node scripts/live-smoke.mjs",
    "check": "npm run build && npm test"
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "dependencies": {
    "typebox": "1.3.15"
  },
  "devDependencies": {
    "openclaw": "2026.7.1-2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  }
}
