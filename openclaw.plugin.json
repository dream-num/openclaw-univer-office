{
  "id": "univer-office",
  "name": "Univer Office",
  "description": "Create, edit, inspect, review, approve, and deliver Office artifacts through Univer Workspace.",
  "version": "0.5.3",
  "activation": {
    "onStartup": true
  },
  "skills": ["./skills"],
  "contracts": {
    "tools": [
      "univer_office_connect",
      "univer_office_files",
      "univer_office_worktree",
      "univer_office_content",
      "univer_office_handoff"
    ]
  },
  "toolMetadata": {
    "univer_office_connect": {
      "profiles": ["full"],
      "sideEffecting": true
    },
    "univer_office_files": {
      "profiles": ["full"],
      "replaySafe": true
    },
    "univer_office_worktree": {
      "profiles": ["full"],
      "sideEffecting": true
    },
    "univer_office_content": {
      "profiles": ["full"],
      "sideEffecting": true
    },
    "univer_office_handoff": {
      "profiles": ["full"],
      "sideEffecting": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "cliPath": {
        "type": "string",
        "minLength": 1,
        "description": "Path or command name for univer-workspace-cli."
      },
      "viewerUrl": {
        "type": "string",
        "pattern": "^https?://",
        "description": "Base URL of the complete Univer Workspace web application used in review links. Defaults to the configured Workspace origin."
      },
      "selfHosted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspaceRoot", "nodePath"],
        "properties": {
          "workspaceRoot": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute path to apps/workspace in a built univer-workspace checkout."
          },
          "nodePath": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute path to a Node.js 24 executable used by Univer Workspace."
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "default": "127.0.0.1"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 3017
          },
          "dataDir": {
            "type": "string",
            "minLength": 1,
            "description": "Optional absolute persistence directory. Defaults to the OpenClaw state directory."
          }
        }
      },
      "commandTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 600000,
        "default": 120000
      },
      "maxOutputBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 16777216,
        "default": 2097152
      },
      "screenshotMaxImages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "default": 12
      }
    }
  },
  "uiHints": {
    "cliPath": {
      "label": "Workspace CLI",
      "help": "Defaults to univer-workspace-cli on PATH."
    },
    "viewerUrl": {
      "label": "Univer Workspace Web URL",
      "help": "Set this only to a deployment of the complete Univer Workspace app, never to a standalone editor or review shell."
    },
    "selfHosted": {
      "label": "Self-hosted Workspace",
      "help": "Run a built, complete Univer Workspace as an OpenClaw companion service.",
      "advanced": true
    },
    "commandTimeoutMs": {
      "label": "Command timeout (ms)",
      "advanced": true
    },
    "maxOutputBytes": {
      "label": "Maximum CLI output bytes",
      "advanced": true
    },
    "screenshotMaxImages": {
      "label": "Maximum screenshot images",
      "advanced": true
    }
  }
}
